node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Runtime state: profile store, run history, raw simc output
# `data/*` not `data/`: git does not descend into an excluded directory, so a
# `!data/.gitkeep` negation under `data/` can never match.
data/*
!data/.gitkeep

# Vendored SimulationCraft binary + build trees
vendor/
engine-wasm/build/
engine-wasm/simc-src/
engine-wasm/dist/
emsdk/

# Desktop packaging output (hundreds of MB) and its temporary staging area
apps/desktop/release/
apps/desktop/node_modules/

# Scratch profiles written while reading item stats out of simc
data/gear-stats/
