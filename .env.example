# --- Local SimulationCraft engine -------------------------------------------
# Absolute path to the simc executable. If unset, the server probes vendor/,
# PATH, and the usual Windows/macOS/Linux install locations.
# SIMC_PATH=C:\Users\James\Projects\WoWProject\vendor\simc\simc.exe

# Iterations for a standard run. SimC defaults to 10000; the target_error
# setting below usually terminates earlier than this.
SIMC_ITERATIONS=10000
SIMC_TARGET_ERROR=0.2
SIMC_FIGHT_STYLE=Patchwerk
SIMC_MAX_TIME=300

# Worker threads per sim run. Defaults to (logical cores - 1).
# SIMC_THREADS=8

# --- Docker engine (fallback when the OS blocks unsigned native binaries) ----
# Image tag built by `npm run simc:docker`.
# SIMC_DOCKER_IMAGE=usim/simc:latest
# Optional CPU cap for the container. Unset = all cores.
# SIMC_DOCKER_CPUS=8

# Concurrent sim jobs. Keep at 1 unless SIMC_THREADS is small: SimC already
# saturates every core it is given, so parallel jobs mostly fight each other.
SIM_CONCURRENCY=1

# --- Server -----------------------------------------------------------------
PORT=8730

# --- Local bridge (SavedVariables watcher) ----------------------------------
# Path to the WoW addon SavedVariables file written by the UnifiedSim addon.
# The server watches this and auto-imports profiles on /reload.
# WOW_SAVEDVARS=C:\Program Files (x86)\World of Warcraft\_retail_\WTF\Account\<ACCOUNT>\SavedVariables\UnifiedSim.lua
WOW_WATCH_ENABLED=true
